{
  "name": "ussrunning-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --pretty false",
    "test:ci": "node --liftoff-only --wasm-num-compilation-tasks=1 --test tests/*.test.mjs",
    "admin:bootstrap": "node scripts/admin/bootstrap.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/database/migrate.mjs",
    "prod:ready": "node --env-file-if-exists=.env.local scripts/production/readiness.mjs",
    "db:test": "node --liftoff-only --wasm-num-compilation-tasks=1 --test tests/database-foundation.test.mjs",
    "auth:test": "node --liftoff-only --wasm-num-compilation-tasks=1 --test tests/auth-account-lifecycle.test.mjs",
    "email:test": "node --liftoff-only --wasm-num-compilation-tasks=1 --test tests/email-verification.test.mjs",
    "rbac:test": "node --liftoff-only --wasm-num-compilation-tasks=1 --test tests/rbac-history.test.mjs",
    "member-card:test": "node --liftoff-only --wasm-num-compilation-tasks=1 --test tests/member-card.test.mjs",
    "member:test": "node --liftoff-only --wasm-num-compilation-tasks=1 --test tests/member-profile.test.mjs",
    "deps:check": "npm ls --all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "next": "16.3.8",
    "qr-scanner": "1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "6.13.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.0"
  },
  "overrides": {
    "@better-auth/core": "1.6.23",
    "@neondatabase/auth-ui@0.3.0-beta": {
      "@daveyplate/better-auth-ui": "3.3.15"
    },
    "@better-fetch/fetch": "1.3.1"
  }
}
