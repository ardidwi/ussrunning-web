# Runtime: pooled Neon PostgreSQL URL. Never use NEXT_PUBLIC_* for credentials.
DATABASE_URL=
# Optional migration-only direct/unpooled URL; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Existing Managed Neon Auth configuration; not changed or provisioned by BE-01.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
USS_SUPER_ADMIN_EMAIL=

# BE-03 transactional email: server-only, lazily validated when issuance is requested.
# Sender domain must be verified with Resend; disable verification-link click tracking.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=USS Running
# Trusted origin only; HTTPS required in production. No credentials/query/path/fragment.
APP_BASE_URL=
EMAIL_VERIFICATION_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RATE_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_MAX_REQUESTS=5
EMAIL_PROVIDER_TIMEOUT_MS=15000
